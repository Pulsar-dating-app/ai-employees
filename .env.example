NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only -- bypasses RLS and column-level grants, never expose to the
# browser (no NEXT_PUBLIC_ prefix). Used to read/write
# company_whatsapp_connections.access_token (Trello D1), which regular
# clients are denied by column-level GRANTs.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Meta app credentials for the WhatsApp Cloud API connect flow (Trello D1).
# Create a Meta app with the WhatsApp product + an Embedded Signup
# configuration at developers.facebook.com to get these. All three are
# server-only (no NEXT_PUBLIC_ prefix) -- whichever page triggers the
# Embedded Signup popup (today: the temporary src/app/dashboard/dev-whatsapp-connect-test;
# permanently: Trello F4) is a Server Component that reads these and passes
# them as props to its Client Component, so the browser never needs its own
# copy of the App ID/Config ID under a separate env var name.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
META_WHATSAPP_CONFIG_ID=your-embedded-signup-config-id

# Instagram connect flow (Trello N2, Business Login for Instagram). Add the
# Instagram product to the same Meta app WhatsApp uses (not a new app), then
# get these from App Dashboard > Instagram > API setup with Instagram login >
# 3. Set up Instagram business login > Business login settings > Instagram
# App ID / Instagram app secret.
#
# NOT the same values as META_APP_ID/META_APP_SECRET above -- Business Login
# for Instagram is issued its own separate credential pair. Sending the
# top-level Meta App ID as client_id here gets rejected by Instagram's
# authorize endpoint with "Invalid platform app" (found live, 2026-08-31).
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
# No config-id equivalent needed (unlike WhatsApp's Embedded Signup) --
# Business Login for Instagram is a plain OAuth redirect
# (src/lib/instagram/meta-instagram-api.ts's buildAuthorizeUrl), not a
# JS-SDK popup flow. Meta's App Dashboard requires an https redirect URI
# outright -- a plain http://localhost:... value is rejected, unlike some
# other Meta OAuth flows. Run `npm run dev:https` (next dev --experimental-https)
# to serve the app over https://localhost:3000 with a self-signed cert when
# testing this end to end; the browser's certificate warning on first load
# is expected, not a bug.
# Test-only overrides so tests/integration can point both hosts at a local
# mock instead of the real Instagram endpoints -- never set these in a real
# environment. See tests/integration/helpers/instagram-api-mock.ts.
# INSTAGRAM_API_BASE_URL=http://127.0.0.1:PORT
# INSTAGRAM_GRAPH_BASE_URL=http://127.0.0.1:PORT

# Instagram inbound webhook (Trello N4). A string you choose yourself --
# enter the same value in App Dashboard > Instagram > API setup with
# Instagram login > Configure webhooks > Verify Token when registering
# Callback URL https://your-app-domain.example/api/webhooks/instagram.
# Never reused for anything else; this is not a Meta-issued secret. The
# webhook payload's own X-Hub-Signature-256 is verified against the
# top-level META_APP_SECRET above, not INSTAGRAM_APP_SECRET -- Meta signs
# every webhook with the app-level secret regardless of which product
# triggered it (see src/lib/instagram/webhook-signature.ts).
INSTAGRAM_WEBHOOK_VERIFY_TOKEN=choose-your-own-verify-token

# Google OAuth credentials for the Calendar connect flow (Trello I1). Create
# an OAuth 2.0 Client ID (Web application type) at
# console.cloud.google.com/apis/credentials with the Calendar API enabled.
# Both server-only (no NEXT_PUBLIC_ prefix) -- K2's (not yet built) dashboard
# screen is a Server Component that reads GOOGLE_CLIENT_ID and passes it as a
# prop to the Client Component that triggers Google Identity Services'
# popup code client; GOOGLE_CLIENT_SECRET never reaches the browser, it's
# only used server-side by src/lib/google-calendar/oauth.ts's token exchange.
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
# Test-only override so tests/integration can point the token exchange at a
# local mock instead of the real Google endpoint -- never set this in a real
# environment. See tests/integration/helpers/google-oauth-mock.ts.
# GOOGLE_OAUTH_TOKEN_URL=http://127.0.0.1:PORT

# OpenAI (Trello C1 -- Agent Engine). Server-only. Create at
# platform.openai.com/api-keys, scoped to a dedicated project.
OPENAI_API_KEY=your-openai-api-key
# Model id for the Agent Engine's Responses API calls -- no DB column holds
# this (see src/lib/agent-engine/constants.ts), so it's env-configurable.
OPENAI_MODEL=gpt-5.4-mini
# Hybrid product search (pgvector) -- test-only kill switch, never set this in
# a real environment. tests/integration/global-setup.ts sets it for the
# spawned test process so product create/update never makes a real
# embeddings API call during the integration suite. See
# src/lib/products/embeddings.ts.
# DISABLE_PRODUCT_EMBEDDINGS=true

# Shared secret for scheduled-job routes (Trello N6 -- Instagram token
# refresh, POST/GET /api/cron/instagram/refresh-tokens). Server-only, any
# long random string. The scheduler must send `Authorization: Bearer
# <this>`. With Supabase pg_cron this value also goes in the database Vault
# as `instagram_token_refresh_cron_secret` (plus `app_base_url`); see
# supabase/migrations/20260902130000_instagram_token_refresh_cron.sql. On
# Vercel Cron, Vercel injects this header automatically from the same env var.
CRON_SECRET=choose-a-long-random-string

# Transactional email (Trello R1 -- booking confirmations R3, reminders R4).
# Resend (resend.com) API key + the verified From address. Server-only.
# Without both set, sendEmail() is a logged no-op (bookings/reminders still
# succeed, just no mail goes out).
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Staffra <no-reply@staffra.io>
# Test-only override so tests/integration can point sendEmail at a local
# mock instead of the real Resend API -- never set this in a real
# environment. See tests/integration/helpers/email-mock.ts.
# RESEND_API_BASE_URL=http://127.0.0.1:PORT

# Base URL that Malu's trackable checkout links are built from (Trello C4).
# A link is `{this}/c/{tracking-id}` -- `staffra.link` was resolved as a path on
# this app, not a separate domain, so Trello E1's redirect route lives here
# too. Server-only. Outside production this defaults to http://localhost:3000
# when unset; in production a missing value throws rather than sending real
# customers a localhost link over WhatsApp.
# Also the origin the Stripe Checkout `success_url` / `cancel_url` and the
# customer-portal `return_url` are built from (Trello P3/P4) -- it's this
# app's public origin, which those flows need too; a separate APP_BASE_URL
# would just be the same value under a second name.
STAFFRA_CHECKOUT_BASE_URL=https://your-app-domain.example

# Stripe -- merchant subscription billing (Trello epic P). All server-only
# (no NEXT_PUBLIC_ prefix): the publishable key is only ever passed from a
# Server Component to a Client Component as a prop, the way GOOGLE_CLIENT_ID
# and META_APP_ID already are, so the browser never needs its own env var.
#
# STRIPE_SECRET_KEY / STRIPE_PUBLISHABLE_KEY: Dashboard > Developers > API
#   keys, for the account you're targeting. Use the *sandbox* account's test
#   keys for local/dev (`sk_test_...` / `pk_test_...`); the live account's
#   keys only in production.
# STRIPE_WEBHOOK_SECRET: the signing secret for the P4 webhook endpoint
#   (`whsec_...`). Locally it's printed by `stripe listen --forward-to
#   localhost:3000/api/webhooks/stripe`; in a deployed environment it's shown
#   when you register the endpoint under Developers > Webhooks. Each endpoint
#   has its own secret -- don't reuse the CLI one in production.
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-signing-secret
