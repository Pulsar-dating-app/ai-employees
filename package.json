{
  "name": "sidde-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:unit",
    "test:unit": "vitest run --project=unit",
    "test:integration": "npm run test:integration:env:up && npm run test:integration:env:reset && vitest run --project=integration",
    "test:integration:env:up": "supabase start",
    "test:integration:env:reset": "supabase db reset",
    "test:integration:env:down": "supabase stop"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "clsx": "^2.1.1",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "next": "16.3.2",
    "next-intl": "^4.13.7",
    "openai": "^7.5.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "supabase": "^2.115.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
